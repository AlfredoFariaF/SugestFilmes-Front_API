<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Categorias - SugestFilmes</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css"></head><body>
<c:set var="activePage" value="categorias"/><%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<main class="container page-space"><div class="page-header"><div><h1>Categorias</h1><p>Explore os gêneros e temas disponíveis para recomendações.</p></div><c:if test="${ehAdmin}"><a class="btn" href="${pageContext.request.contextPath}/categorias?acao=novo">+ Nova categoria</a></c:if></div>
<c:if test="${not empty erro}"><div class="alert alert-erro"><c:out value="${erro}"/></div></c:if>
<div class="card"><c:choose><c:when test="${empty categorias}"><div class="empty">Nenhuma categoria cadastrada.</div></c:when><c:otherwise><div class="category-grid"><c:forEach var="categoria" items="${categorias}"><div class="category-option"><span><c:out value="${categoria.nome}"/></span><c:if test="${ehAdmin}"><div class="card-actions"><a class="btn btn-secondary btn-small" href="${pageContext.request.contextPath}/categorias?acao=editar&id=${categoria.id}">Editar</a><form method="post" action="${pageContext.request.contextPath}/categorias" onsubmit="return confirm('Excluir esta categoria?');"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="acao" value="excluir"><input type="hidden" name="id" value="${categoria.id}"><button class="btn btn-danger btn-small" type="submit">Excluir</button></form></div></c:if></div></c:forEach></div></c:otherwise></c:choose></div></main></body></html>
