<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Perfis - SugestFilmes</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css"></head><body>
<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %><main class="container page-space"><div class="page-header"><div><h1>Perfis</h1><p>Gerencie os perfis e níveis de acesso.</p></div><a class="btn" href="${pageContext.request.contextPath}/perfis?acao=novo">+ Novo perfil</a></div><c:if test="${not empty erro}"><div class="alert alert-erro"><c:out value="${erro}"/></div></c:if>
<div class="card"><c:choose><c:when test="${empty perfis}"><div class="empty">Nenhum perfil cadastrado.</div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>ID</th><th>Nome</th><th>Ações</th></tr></thead><tbody><c:forEach var="p" items="${perfis}"><tr><td>${p.id}</td><td><c:out value="${p.nome}"/></td><td class="links"><a href="${pageContext.request.contextPath}/perfis?acao=editar&id=${p.id}">Editar</a><form method="post" action="${pageContext.request.contextPath}/perfis" onsubmit="return confirm('Excluir este perfil?');"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="acao" value="excluir"><input type="hidden" name="id" value="${p.id}"><button class="btn btn-danger btn-small" type="submit">Excluir</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></main></body></html>
