<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Recomendações - SugestFilmes</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css"></head><body>
<c:set var="activePage" value="recomendacoes"/><%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<main class="container page-space"><div class="page-header"><div><h1>Recomendações</h1><p>Os filmes são ordenados conforme as categorias selecionadas e os critérios da API.</p></div></div><c:if test="${not empty erro}"><div class="alert alert-erro"><c:out value="${erro}"/></div></c:if>
<form method="get" action="${pageContext.request.contextPath}/recomendacoes" class="card recommendation-filter"><h2>Escolha suas categorias</h2><div class="category-grid"><c:forEach var="categoria" items="${categorias}"><label class="category-option"><input type="checkbox" name="categoria" value="${categoria.id}" <c:if test="${selecionadas.contains(categoria.id)}">checked</c:if>><span><c:out value="${categoria.nome}"/></span></label></c:forEach></div><div class="center-actions"><button class="btn" type="submit">Atualizar recomendações</button></div></form>
<c:choose><c:when test="${empty selecionadas}"><div class="empty">Escolha pelo menos uma categoria para receber sugestões.</div></c:when><c:when test="${empty filmes}"><div class="empty">Nenhum filme possui as categorias selecionadas.</div></c:when><c:otherwise><div class="movie-grid"><c:forEach var="filme" items="${filmes}"><article class="movie-card"><div class="movie-poster"><span>🎬</span><span class="match-badge"><c:out value="${filme.correspondencias}"/> categoria(s)</span></div><div class="movie-body"><h3><c:out value="${filme.titulo}"/></h3><p class="movie-meta"><c:out value="${filme.genero}"/> · <c:out value="${filme.ano}"/></p><p class="match-text">Combina com <strong><c:out value="${filme.correspondencias}"/></strong> das categorias escolhidas.</p><div class="rating">Nota: <strong><c:choose><c:when test="${filme.totalAvaliacoes > 0}"><c:out value="${filme.mediaAvaliacao}"/></c:when><c:otherwise>Sem avaliações</c:otherwise></c:choose></strong></div><a class="btn btn-secondary btn-small" href="${pageContext.request.contextPath}/filmes?acao=detalhes&id=${filme.id}">Ver detalhes</a></div></article></c:forEach></div></c:otherwise></c:choose></main></body></html>
