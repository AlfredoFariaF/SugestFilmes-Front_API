<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Avaliações - SugestFilmes</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css"></head><body>
<c:set var="activePage" value="avaliacoes"/><%@ include file="/WEB-INF/jsp/fragments/header.jspf" %>
<main class="container page-space"><div class="page-header"><div><h1><c:choose><c:when test="${not empty filmeId}">Avaliações do filme</c:when><c:otherwise>Minhas avaliações</c:otherwise></c:choose></h1><p>Consulte e mantenha suas avaliações.</p></div><a class="btn btn-secondary" href="${pageContext.request.contextPath}/filmes">Voltar aos filmes</a></div>
<c:if test="${not empty erro}"><div class="alert alert-erro"><c:out value="${erro}"/></div></c:if><div class="card"><c:choose><c:when test="${empty avaliacoes}"><div class="empty">Nenhuma avaliação encontrada.</div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Filme</th><th>Usuário</th><th>Nota</th><th>Comentário</th><th>Data</th><th>Ações</th></tr></thead><tbody>
<c:forEach var="a" items="${avaliacoes}"><tr><td><c:out value="${a.tituloFilme}"/></td><td><c:out value="${a.nomeUsuario}"/></td><td>⭐ ${a.nota}/5</td><td><c:out value="${a.comentario}"/></td><td><c:out value="${a.dataAvaliacao}"/></td><td><c:if test="${a.usuarioId == sessionScope.usuarioLogado.id}"><a class="btn btn-secondary btn-small" href="${pageContext.request.contextPath}/avaliacoes?acao=editar&id=${a.id}">Editar</a></c:if><c:if test="${a.usuarioId == sessionScope.usuarioLogado.id || ehAdmin}"><form method="post" action="${pageContext.request.contextPath}/avaliacoes" onsubmit="return confirm('Excluir esta avaliação?');"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="acao" value="excluir"><input type="hidden" name="id" value="${a.id}"><c:if test="${not empty filmeId}"><input type="hidden" name="filmeId" value="${filmeId}"></c:if><button class="btn btn-danger btn-small" type="submit">Excluir</button></form></c:if></td></tr></c:forEach>
</tbody></table></div></c:otherwise></c:choose></div></main></body></html>
