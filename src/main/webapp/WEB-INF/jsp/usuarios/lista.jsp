<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Usuários - SugestFilmes</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css"></head><body>
<%@ include file="/WEB-INF/jsp/fragments/header.jspf" %><main class="container page-space"><div class="page-header"><div><h1>Usuários</h1><p>Administre as contas cadastradas.</p></div><a class="btn" href="${pageContext.request.contextPath}/usuarios?acao=novo">+ Novo usuário</a></div>
<c:if test="${not empty erro}"><div class="alert alert-erro"><c:out value="${erro}"/></div></c:if><div class="card"><c:choose><c:when test="${empty usuarios}"><div class="empty">Nenhum usuário cadastrado.</div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>ID</th><th>Nome</th><th>Login</th><th>Perfil</th><th>Ações</th></tr></thead><tbody><c:forEach var="u" items="${usuarios}"><tr><td>${u.id}</td><td><c:out value="${u.nome}"/></td><td><c:out value="${u.login}"/></td><td><c:out value="${u.perfil.nome}"/></td><td class="links"><a href="${pageContext.request.contextPath}/usuarios?acao=editar&id=${u.id}">Editar</a><form method="post" action="${pageContext.request.contextPath}/usuarios" onsubmit="return confirm('Excluir este usuário?');"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="acao" value="excluir"><input type="hidden" name="id" value="${u.id}"><button class="btn btn-danger btn-small" type="submit">Excluir</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></div></main></body></html>
